{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soil.telemetry.v1",
  "title": "Soil telemetry MQTT payload V1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "greenhouse_id",
    "zone_id",
    "device_id",
    "device_time",
    "sequence",
    "readings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "greenhouse_id": {
      "type": "string",
      "minLength": 1
    },
    "zone_id": {
      "type": "string",
      "minLength": 1
    },
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "device_time": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "replayed": {
      "type": "boolean"
    },
    "replayed_at_device_time": {
      "type": "string"
    },
    "readings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sensor_id",
          "metric",
          "value",
          "unit"
        ],
        "properties": {
          "sensor_id": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "type": "string",
            "enum": [
              "soil_moisture_pct",
              "soil_temperature_c",
              "soil_ph",
              "soil_ec_us_cm",
              "soil_n_mg_kg",
              "soil_p_mg_kg",
              "soil_k_mg_kg"
            ]
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "enum": [
              "%",
              "C",
              "pH",
              "us/cm",
              "mg/kg"
            ]
          }
        }
      }
    }
  }
}
